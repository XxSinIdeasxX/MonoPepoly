<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: follows the system day/night mode (or the in-app switch) -->
    <style name="Base.Theme.Mono" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Green for accept/action buttons (dialog positives); yellow accents come from the accent_* colors -->
        <item name="colorPrimary">@color/action</item>
        <item name="colorOnPrimary">@color/on_action</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <!-- Dialog surface follows the card color instead of Material's lavender tint -->
        <item name="colorSurfaceContainerHigh">@color/frost</item>
        <item name="colorSurface">@color/surface</item>
        <!-- Menus, dialogs and fields sit on light surfaces in both modes, so their text stays dark -->
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/frost</item>
        <item name="colorSurfaceVariant">@color/frost</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Mono.Dialog</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- Toolbar buttons: yellow accents, soft fill at rest and amber when active, no outline -->
    <style name="Widget.Mono.Accent" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/accent_bg</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="iconTint">@color/accent_text</item>
    </style>

    <!-- Icon-only buttons: yellow icon that darkens when pressed; never a background, ripple or state layer -->
    <style name="Widget.Mono.IconAction" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/icon_tint</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Text-only button: colored text that darkens when pressed; no background or ripple -->
    <style name="Widget.Mono.TextAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/icon_tint</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Dialog negative buttons (Cancelar, Cerrar): red text, no background -->
    <style name="ThemeOverlay.Mono.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Mono.NegativeButton</item>
    </style>

    <style name="Widget.Mono.NegativeButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/close_red</item>
    </style>

    <style name="Theme.Mono" parent="Base.Theme.Mono" />

    <!-- Full-screen overlay for the game dialogs: transparent, edge-to-edge (system bars included), no dim of its own -->
    <style name="Theme.Mono.FullScreenDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
