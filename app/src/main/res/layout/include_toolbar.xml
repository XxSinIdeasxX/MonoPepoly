<?xml version="1.0" encoding="utf-8"?>
    <!-- Toolbar: view button, filters (popup menu) or the game state in Juego, and Juego as an icon at the end -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_view"
            style="@style/Widget.Mono.IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Cambiar entre vista de cartas y lista"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_view_cards"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filters"
            style="@style/Widget.Mono.TextAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Todas ▾" />

        <!-- Replaces the filters while Juego is open: game state and initial balance picker -->
        <LinearLayout
            android:id="@+id/layout_game_bar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accent_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preparación"
                android:textColor="@color/slate"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_initial_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo inicial"
                android:textColor="@color/slate"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_initial_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_initial_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="$1500"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game"
            style="@style/Widget.Mono.IconAction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:checkable="true"
            android:contentDescription="Juego"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_game"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>

